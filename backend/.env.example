# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/attendease
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/attendease?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/attendease

# JWT Authentication Secret (Use a strong, random 32+ character string)
JWT_SECRET=replace_this_with_a_secure_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Initial Super Admin Setup (Used ONLY by seed script; never hardcoded)
ADMIN_NAME=College Super Admin
ADMIN_EMAIL=admin@attendease.edu
ADMIN_INITIAL_PASSWORD=SetAStrongPassword123!

# Client App URL (For CORS protection)
CLIENT_URL=http://localhost:5173
